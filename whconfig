-- Fungsi otomatis mengecek blacklist dari link GitHub untuk Rebirth & Hatch
task.spawn(function()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    repeat task.wait() until LocalPlayer and LocalPlayer.Name

    local urlBlacklist = "https://github.com/afreditiyan/petsim/raw/refs/heads/main/username"
    
    local success, response = pcall(function()
        return game:HttpGet(urlBlacklist)
    end)

    if success and response then
        for username in response:gmatch("[^\r\n]+") do
            username = username:gsub("^%s*(.-)%s*$", "%1")
            
            if LocalPlayer.Name == username then
                -- Matikan Auto Rebirth jika masuk list
                if _G.PS99Config["Rebirth"] then
                    _G.PS99Config["Rebirth"]["Auto Rebirth"] = false
                    print("🛡️ [Cloud Blacklist] Username '" .. username .. "' terdeteksi! Auto Rebirth dinonaktifkan otomatis.")
                end
                
                -- Matikan Auto Hatch jika masuk list
                if _G.PS99Config["Eggs"] then
                    _G.PS99Config["Eggs"]["Auto Hatch"] = false
                    print("🛡️ [Cloud Blacklist] Username '" .. username .. "' terdeteksi! Auto Hatch dinonaktifkan otomatis.")
                end
                
                break
            end
        end
    else
        warn("⚠️ Gagal memuat daftar blacklist dari GitHub.")
    end
end)

